# Optional AI provider key.
# Current integration mode: Option A. Only the current chat message is sent to OpenAI.
# Child memory/profile fields are kept local and are not sent to OpenAI.
# OPENAI_API_KEY=
# OPENAI_KRISHNA_MODEL=gpt-4.1-mini

# Supabase: required for real accounts and cloud journey storage.
# All keys are server-only. Never use a NEXT_PUBLIC_ prefix for secret keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (or legacy service_role key): used ONLY for account deletion.
SUPABASE_SECRET_KEY=
# Canonical app origin for confirmation emails, without a trailing path.
# Example locally: http://localhost:3000
LEELA_APP_URL=
